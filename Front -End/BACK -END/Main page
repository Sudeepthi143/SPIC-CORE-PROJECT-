import os
import json
import uuid

from fastapi import (
    FastAPI,
    UploadFile,
    File,
    Form,
    Depends,
    HTTPException
)

from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse

from sqlalchemy.orm import Session

from passlib.context import CryptContext

from pptx import Presentation
from pptx.util import Inches

from database import Base, engine, get_db
from models import User, Presentation as PresentationModel


# --------------------------------------------------
# APP
# --------------------------------------------------

app = FastAPI(
    title="AI PPT Generator API",
    description="Backend for AI Automatic PPT Generation",
    version="1.0.0"
)


# --------------------------------------------------
# CORS
# --------------------------------------------------

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# --------------------------------------------------
# DATABASE
# --------------------------------------------------

Base.metadata.create_all(
    bind=engine
)


# --------------------------------------------------
# PASSWORD HASHING
# --------------------------------------------------

pwd_context = CryptContext(
    schemes=["bcrypt"],
    deprecated="auto"
)


# --------------------------------------------------
# DIRECTORIES
# --------------------------------------------------

IMAGE_FOLDER = "uploads/images"
PPT_FOLDER = "generated_ppt"

os.makedirs(
    IMAGE_FOLDER,
    exist_ok=True
)

os.makedirs(
    PPT_FOLDER,
    exist_ok=True
)


# --------------------------------------------------
# ROOT
# --------------------------------------------------

@app.get("/")
def home():

    return {
        "message": "AI PPT Generator Backend is running",
        "status": "success"
    }


# --------------------------------------------------
# REGISTER
# --------------------------------------------------

@app.post("/api/register")
def register_user(
    user_name: str = Form(...),
    email: str = Form(...),
    password: str = Form(...),
    db: Session = Depends(get_db)
):

    existing_user = (
        db.query(User)
        .filter(User.email == email)
        .first()
    )

    if existing_user:

        raise HTTPException(
            status_code=400,
            detail="Email already registered"
        )

    hashed_password = pwd_context.hash(
        password
    )

    user = User(
        user_name=user_name,
        email=email,
        password_hash=hashed_password
    )

    db.add(user)
    db.commit()
    db.refresh(user)

    return {
        "message": "Registration successful",
        "user_id": user.id,
        "user_name": user.user_name,
        "email": user.email
    }


# --------------------------------------------------
# LOGIN
# --------------------------------------------------

@app.post("/api/login")
def login_user(
    email: str = Form(...),
    password: str = Form(...),
    db: Session = Depends(get_db)
):

    user = (
        db.query(User)
        .filter(User.email == email)
        .first()
    )

    if not user:

        raise HTTPException(
            status_code=401,
            detail="Invalid email or password"
        )

    password_valid = pwd_context.verify(
        password,
        user.password_hash
    )

    if not password_valid:

        raise HTTPException(
            status_code=401,
            detail="Invalid email or password"
        )

    return {
        "message": "Login successful",
        "user_id": user.id,
        "user_name": user.user_name,
        "email": user.email
    }


# --------------------------------------------------
# GENERATE POWERPOINT
# --------------------------------------------------

@app.post("/api/generate-ppt")
async def generate_ppt(

    user_id: int = Form(...),

    title: str = Form(...),

    slide_count: int = Form(...),

    images: list[UploadFile] = File(...),

    db: Session = Depends(get_db)

):

    # ----------------------------------------------
    # VALIDATION
    # ----------------------------------------------

    if slide_count < 1:

        raise HTTPException(
            status_code=400,
            detail="Slide count must be at least 1"
        )

    if not title.strip():

        raise HTTPException(
            status_code=400,
            detail="Presentation title is required"
        )

    if len(images) == 0:

        raise HTTPException(
            status_code=400,
            detail="Please upload at least one image"
        )


    # ----------------------------------------------
    # CHECK USER
    # ----------------------------------------------

    user = (
        db.query(User)
        .filter(User.id == user_id)
        .first()
    )

    if not user:

        raise HTTPException(
            status_code=404,
            detail="User not found"
        )


    # ----------------------------------------------
    # SAVE IMAGES
    # ----------------------------------------------

    saved_images = []

    for image in images:

        extension = os.path.splitext(
            image.filename
        )[1].lower()

        allowed_extensions = [
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
        ]

        if extension not in allowed_extensions:

            continue

        unique_name = (
            str(uuid.uuid4())
            + extension
        )

        image_path = os.path.join(
            IMAGE_FOLDER,
            unique_name
        )

        content = await image.read()

        with open(
            image_path,
            "wb"
        ) as file:

            file.write(content)

        saved_images.append(
            image_path
        )


    if len(saved_images) == 0:

        raise HTTPException(
            status_code=400,
            detail="No valid images uploaded"
        )


    # ----------------------------------------------
    # CREATE PPT
    # ----------------------------------------------

    ppt = Presentation()

    # Standard widescreen presentation
    ppt.slide_width = Inches(13.333)
    ppt.slide_height = Inches(7.5)


    # ----------------------------------------------
    # TITLE SLIDE
    # ----------------------------------------------

    title_slide_layout = ppt.slide_layouts[0]

    title_slide = ppt.slides.add_slide(
        title_slide_layout
    )

    title_slide.shapes.title.text = title

    if len(title_slide.placeholders) > 1:

        title_slide.placeholders[
            1
        ].text = (
            f"Generated using AI PPT Generator\n"
            f"Created for {user.user_name}"
        )


    # ----------------------------------------------
    # CONTENT SLIDES
    # ----------------------------------------------

    content_slide_layout = ppt.slide_layouts[6]


    for slide_number in range(
        1,
        slide_count
    ):

        slide = ppt.slides.add_slide(
            content_slide_layout
        )


        # Slide title
        textbox = slide.shapes.add_textbox(
            Inches(0.6),
            Inches(0.3),
            Inches(12),
            Inches(0.7)
        )

        textbox.text_frame.text = (
            f"{title} - Slide {slide_number}"
        )


        # Select image
        image_index = (
            slide_number - 1
        ) % len(saved_images)

        image_path = saved_images[
            image_index
        ]


        # Add image
        slide.shapes.add_picture(
            image_path,
            Inches(1.2),
            Inches(1.3),
            width=Inches(10.8),
            height=Inches(5.5)
        )


    # ----------------------------------------------
    # SAVE PPT
    # ----------------------------------------------

    safe_title = "".join(
        character
        for character in title
        if character.isalnum()
        or character in (
            " ",
            "_",
            "-"
        )
    ).strip()

    if not safe_title:

        safe_title = "AI_Presentation"


    filename = (
        f"{safe_title}_"
        f"{uuid.uuid4().hex[:8]}.pptx"
    )

    ppt_path = os.path.join(
        PPT_FOLDER,
        filename
    )

    ppt.save(ppt_path)


    # ----------------------------------------------
    # SAVE DATABASE RECORD
    # ----------------------------------------------

    presentation = PresentationModel(

        user_id=user.id,

        title=title,

        slide_count=slide_count,

        image_paths=json.dumps(
            saved_images
        ),

        generated_ppt=ppt_path
    )

    db.add(presentation)

    db.commit()

    db.refresh(presentation)


    # ----------------------------------------------
    # RESPONSE
    # ----------------------------------------------

    return {

        "message":
            "PowerPoint generated successfully",

        "sl_no":
            presentation.id,

        "user_name":
            user.user_name,

        "email":
            user.email,

        "title":
            presentation.title,

        "slide_count":
            presentation.slide_count,

        "images_uploaded":
            len(saved_images),

        "generated_ppt":
            f"/api/download-ppt/{presentation.id}"
    }


# --------------------------------------------------
# DOWNLOAD PPT
# --------------------------------------------------

@app.get(
    "/api/download-ppt/{presentation_id}"
)
def download_ppt(
    presentation_id: int,
    db: Session = Depends(get_db)
):

    presentation = (
        db.query(PresentationModel)
        .filter(
            PresentationModel.id
            == presentation_id
        )
        .first()
    )

    if not presentation:

        raise HTTPException(
            status_code=404,
            detail="Presentation not found"
        )


    if not presentation.generated_ppt:

        raise HTTPException(
            status_code=404,
            detail="PPT file not found"
        )


    if not os.path.exists(
        presentation.generated_ppt
    ):

        raise HTTPException(
            status_code=404,
            detail="PPT file does not exist"
        )


    return FileResponse(
        path=presentation.generated_ppt,
        filename=f"{presentation.title}.pptx",
        media_type=(
            "application/vnd.openxmlformats-"
            "officedocument.presentationml.presentation"
        )
    )


# --------------------------------------------------
# GET USER PRESENTATIONS
# --------------------------------------------------

@app.get("/api/user/{user_id}/presentations")
def get_user_presentations(
    user_id: int,
    db: Session = Depends(get_db)
):

    presentations = (
        db.query(PresentationModel)
        .filter(
            PresentationModel.user_id
            == user_id
        )
        .all()
    )

    return [

        {
            "sl_no": presentation.id,

            "title": presentation.title,

            "slide_count":
                presentation.slide_count,

            "generated_ppt":
                (
                    f"/api/download-ppt/"
                    f"{presentation.id}"
                )
        }

        for presentation in presentations

    ]
